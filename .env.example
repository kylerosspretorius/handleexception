APP_NAME="HandleException Invoices"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# -------------------------------------------------------
# Database (MySQL via Docker — port 3307 on host)
# -------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=handleexception_invoices
DB_USERNAME=invoice_user
DB_PASSWORD=invoice_pass
DB_ROOT_PASSWORD=rootpassword

# -------------------------------------------------------
# Session — use database driver
# -------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null

FILESYSTEM_DISK=s3

# -------------------------------------------------------
# AWS S3 (bucket: customerData, region: eu-west-2)
# Create an IAM user with s3:PutObject, s3:GetObject,
# s3:DeleteObject on arn:aws:s3:::customerData/*
# -------------------------------------------------------
AWS_ACCESS_KEY_ID=your-iam-access-key-id
AWS_SECRET_ACCESS_KEY=your-iam-secret-access-key
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=customerData
AWS_USE_PATH_STYLE_ENDPOINT=false

# -------------------------------------------------------
# Google OAuth (create at console.cloud.google.com)
# Authorised redirect URI:
#   http://localhost:8080/auth/google/callback  (local)
#   https://handleexception.com/auth/google/callback  (prod)
# -------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

CACHE_STORE=file
QUEUE_CONNECTION=database

VITE_APP_NAME="${APP_NAME}"
